title STRATEGISAMANDRAG
caption Voss Hang- og Paragliderklubb

top to bottom direction

' --- Overordna stil ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 2
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 32
skinparam ArrowColor #4285F4
skinparam ArrowThickness 1.2

skinparam rectangle {
    BorderColor #8296B2
    FontColor #172033
    BorderThickness 1
    RoundCorner 2
}

' --- Fargepalett ---
!define BLUE #9DB5E0
!define GREEN #A5D096
!define GREY #D9D9D9

' --- Konsept ---
rectangle "Konsept\nOpplevtande erfaringar med luftsport" as Konsept GREY

' --- Bevis ---
rectangle "Bevis\nEi kjensle av eigarskap og tilhøyrsle" as Bevis GREEN
rectangle "Velfungerande fasilitetar" as Fasilitetar BLUE
rectangle "Sunn kultur" as Kultur BLUE
rectangle "Gode kurs og oppfølging" as KursOppfoelging BLUE

' --- Løfte, posisjon og målgruppe ---
rectangle "Løfte\nAktive og nøgde pilotar" as Loefte BLUE
rectangle "Posisjon\nEin ressurssterk klubb som er drivande for\nutviklinga av ekstremsport." as Posisjon BLUE
rectangle "Målgruppe\nMedlemmar som vil ha det kjekt i eit fykande\nfellesskap på Voss!" as Maalgruppe BLUE

' --- Kommunikasjon ---
package "Kommunikasjon" {
  rectangle "Omsynsfull" as Omsynsfull BLUE
  rectangle "Samlande" as Samlande BLUE
  rectangle "Nysgjerrig" as Nysgjerrig BLUE
  rectangle "Leiken gledesspreiar" as Profil GREEN
}

' --- Organisasjon ---
package "Organisasjon" {
  rectangle "Inkludering" as Inkludering BLUE
  rectangle "Utvikling" as Utvikling BLUE
  rectangle "Tryggleik" as Tryggleik BLUE
  rectangle "Spennande moglegheiter" as Moglegheiter GREEN
}

' --- Misjon og visjon ---
rectangle "Misjon\nLeggje til rette for gode opplevingar i lufta,\nog mellom menneske." as Misjon BLUE
rectangle "Visjon\nSkapa trygg og ekte flyglede!" as Visjon BLUE

Bevis -- Fasilitetar
Bevis -- Kultur
Bevis -- KursOppfoelging
Profil -- Omsynsfull
Profil -- Samlande
Profil -- Nysgjerrig
Moglegheiter -- Inkludering
Moglegheiter -- Utvikling
Moglegheiter -- Tryggleik
