title STRATEGISAMANDRAG

top to bottom direction

skinparam handwritten false
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Monospaced
skinparam rectangle {
    BackgroundColor White
    BorderColor #444444
}
skinparam triangle {
    BackgroundColor White
    BorderColor #444444
}

frame "Brand Platform" {

    rectangle "**Konsept**\nOppløftande erfaringar med luftsport" as Konsept
    rectangle "**Bevis**\nEi kjensle av eigarskap og tilhøyrsle" as Bevis

    rectangle "Velfungerande fasilitetar" as B1
    rectangle "Sunn kultur" as B2
    rectangle "Gode kurs og oppfølging" as B3

    rectangle "**Løfte**\nAktive og nøgde pilotar" as Lofte
    rectangle "**Posisjon**\nEin ressurssterk klubb som er drivande for utviklinga av ekstremsport." as Posisjon
    rectangle "**Målgruppe**\nMedlemmar som vil ha det kjekt i eit fykande fellesskap pao Voss!" as Malgruppe

    package "Kommunikasjon: Eigenskapar" {
        rectangle "Omsynsfull" as Omsyn
        rectangle "Samlande" as Samlande
        rectangle "Nysgjerrig" as Nysgjerrig
        rectangle "**Leiken gledesspreiar**" as BrandEigenskap

        Omsyn -[hidden]down- Samlande
        Samlande -[hidden]down- BrandEigenskap
        BrandEigenskap -[hidden]down- Nysgjerrig

        Omsyn -[hidden]right- Nysgjerrig
    }

    package "Organisasjon: Verdiar" {
        rectangle "Inkludering" as Inkludering
        rectangle "Utvikling" as Utvikling
        rectangle "Tryggleik" as Tryggleik
        rectangle "**Spennande moglegheiter**" as BrandVerdi

        Inkludering -[hidden]right- BrandVerdi
        BrandVerdi -[hidden]right- Utvikling
        BrandVerdi -[hidden]down- Tryggleik
    }

    rectangle "**Misjon**\nLeggje til rette for gode opplevingar i lufta, og mellom menneske." as Misjon
    rectangle "**Visjon**\nSkapa trygg og ekte flyglede!" as Visjon
}

Konsept -[hidden]down- Bevis
Bevis -[hidden]down- B2
B1 -[hidden]right- B2
B2 -[hidden]right- B3
B2 -[hidden]down- Lofte
Lofte -[hidden]down- Posisjon
Posisjon -[hidden]down- Malgruppe
Malgruppe -[hidden]down- Omsyn
Nysgjerrig -[hidden]down- Inkludering
Tryggleik -[hidden]down- Misjon
Misjon -[hidden]down- Visjon
