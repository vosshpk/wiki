top to bottom direction

skinparam handwritten false
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Monospaced
skinparam defaultFontSize 13
skinparam nodesep 25
skinparam ranksep 25

skinparam rectangle {
    BackgroundColor White
    BorderColor #222222
    BorderThickness 1.5
}
skinparam package {
    BackgroundColor White
    BorderColor #222222
    BorderThickness 1.5
    FontStyle bold
}
skinparam ArrowColor #222222
skinparam ArrowThickness 1.5

rectangle "**Concept**\nUplifting experiences with air sports" as Concept
rectangle "**Evidence**\nA sense of ownership and belonging" as Evidence

rectangle "Well-functioning\nfacilities" as B1
rectangle "Healthy culture" as B2
rectangle "Good courses and\nfollow-up" as B3

rectangle "**Promise**\nActive and satisfied pilots" as Promise
rectangle "**Position**\nA well-resourced club that drives\nthe development of adventure sports." as Position
rectangle "**Target group**\nMembers who want to have fun in a\nflying community in Voss!" as TargetGroup

package "Communication: Qualities" as Communication {
    rectangle "Considerate" as Considerate #EBF3FA
    rectangle "Unifying" as Unifying #EBF3FA
    rectangle "**A playful bringer of joy**" as Qualities #EBF3FA
    rectangle "Curious" as Curious #EBF3FA

    Considerate -[hidden]down- Qualities
    Unifying -[hidden]right- Qualities
    Qualities -[hidden]right- Curious
}

package "Organisation: Values" as Organisation {
    rectangle "Inclusion" as Inclusion #EAF5EA
    rectangle "Safety" as Safety #EAF5EA
    rectangle "**Exciting opportunities**" as Values #EAF5EA
    rectangle "Development" as Development #EAF5EA

    Inclusion -[hidden]down- Values
    Safety -[hidden]right- Values
    Values -[hidden]right- Development
}

rectangle "**Mission**\nFacilitate good experiences\nin the air and among people." as Mission
rectangle "**Vision**\nCreate safe and genuine joy in flying!" as Vision

Concept --> Evidence
Evidence --> B1
Evidence --> B2
Evidence --> B3

B1 -[hidden]right- B2
B2 -[hidden]right- B3

B2 --> Promise
Promise --> Position
Position --> TargetGroup

TargetGroup --> Communication
TargetGroup --> Organisation

Communication --> Mission
Organisation --> Mission

Mission --> Vision

Communication -[hidden]right- Organisation
